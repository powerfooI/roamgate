{
  "name": "roamgate-server",
  "private": true,
  "version": "0.7.6",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "HOST=127.0.0.1 PORT=8788 bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "compile": "bun build --compile --minify --sourcemap --asset ./public --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/index.ts --outfile roamgate",
    "postcompile": "bun run clean:bun-build",
    "compile:darwin-arm64": "bun build --compile --minify --sourcemap --asset ./public --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-darwin-arm64 src/index.ts --outfile roamgate-darwin-arm64",
    "postcompile:darwin-arm64": "bun run clean:bun-build",
    "compile:darwin-x64": "bun build --compile --minify --sourcemap --asset ./public --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-darwin-x64 src/index.ts --outfile roamgate-darwin-x64",
    "postcompile:darwin-x64": "bun run clean:bun-build",
    "compile:linux-x64": "bun build --compile --minify --sourcemap --asset ./public --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-linux-x64 src/index.ts --outfile roamgate-linux-x64",
    "postcompile:linux-x64": "bun run clean:bun-build",
    "compile:linux-arm64": "bun build --compile --minify --sourcemap --asset ./public --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-linux-arm64 src/index.ts --outfile roamgate-linux-arm64",
    "postcompile:linux-arm64": "bun run clean:bun-build",
    "compile:linux-x64-musl": "bun build --compile --minify --sourcemap --asset ./public --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-linux-x64-musl src/index.ts --outfile roamgate-linux-x64-musl",
    "postcompile:linux-x64-musl": "bun run clean:bun-build",
    "compile:windows-x64": "bun build --compile --minify --sourcemap --asset ./public --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-windows-x64 src/index.ts --outfile roamgate-windows-x64",
    "compile:windows-arm64": "bun build --compile --minify --sourcemap --asset ./public --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-windows-arm64 src/index.ts --outfile roamgate-windows-arm64",
    "compile:all": "bun run compile:darwin-arm64 && bun run compile:darwin-x64 && bun run compile:linux-x64 && bun run compile:linux-arm64 && bun run compile:linux-x64-musl && bun run compile:windows-x64 && bun run compile:windows-arm64",
    "postcompile:all": "bun run clean:bun-build",
    "clean:bun-build": "find . -maxdepth 1 -name '*.bun-build' -exec rm -rf {} +",
    "clean": "rm -rf public src/public-files.gen.ts roamgate roamgate.exe roamgate-* herdr-gui herdr-gui-* && bun run clean:bun-build",
    "pretypecheck": "bun run --filter roamgate-web build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  }
}
